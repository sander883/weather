# Weather API Keys
OPENWEATHERMAP_API_KEY=your_openweathermap_key
WEATHERAPI_KEY=your_weatherapi_key
NOAA_API_KEY=optional_noaa_key

# Polymarket Configuration
POLYMARKET_API_URL=https://api.polymarket.com
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_WALLET_ADDRESS=your_wallet_address

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/polymarket_weather
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Trading Parameters
CAPITAL_BASE=10000
MAX_DAILY_LOSS_PERCENT=2.0
MAX_OPEN_POSITIONS=5
EDGE_THRESHOLD=0.05

# Feature Configuration
FEATURE_LOOKBACK_DAYS=30
MODEL_RETRAIN_INTERVAL=604800  # 7 days in seconds

# API Rate Limiting
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# Dashboard
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
DEBUG_MODE=False
